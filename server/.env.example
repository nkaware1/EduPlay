# ===== الخادم =====
PORT=4000
NODE_ENV=development
# غيّر هذا السر قبل النشر (مطلوب في وضع production)
JWT_SECRET=change-me-to-a-long-random-string
# عنوان الواجهة في وضع التطوير (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ===== قاعدة البيانات =====
# json  → ملف JSON محلي (الافتراضي، لا يحتاج أي إعداد)
# mongo → MongoDB
DB_DRIVER=json
JSON_DB_PATH=./data/db.json
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=lamaa

# ===== أول تشغيل =====
# في وضع التطوير تُنشأ حسابات تجريبية وأنشطة نموذجية تلقائيًا.
# في production أنشئ مدير المنصة بهذه المتغيرات (وفعّل SEED_DEMO=true فقط إن أردت بيانات تجريبية):
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# SEED_DEMO=false

# ===== التوليد بالذكاء الاصطناعي (اختياري) =====
# بدون المفتاح يبقى زر «توليد» معطّلًا ويعمل كل شيء آخر.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5-5
# AI_MAX_PER_HOUR=30
